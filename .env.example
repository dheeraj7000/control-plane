# Copy to .env for local development: cp .env.example .env
# apps/server reads these directly from the environment (see internal/config).

APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=15

# Ports below match docker-compose.yml's host-side mappings, which are
# bumped from Postgres/Redis defaults to avoid colliding with any
# locally-installed instance. Only relevant when running the server on
# the host against `make dev-up` infra — the containerized server (`make
# docker-up`) talks to these over the Compose network instead.
DATABASE_URL=postgres://control_plane:control_plane@localhost:55432/control_plane?sslmode=disable
REDIS_URL=redis://localhost:56379/0
NATS_URL=nats://localhost:4222

# stdout | otlp | none
OTEL_EXPORTER=stdout
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

SERVICE_NAME=control-plane-server
