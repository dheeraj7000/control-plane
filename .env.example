# Copy to .env for local development: cp .env.example .env
# apps/server reads these directly from the environment (see internal/config).

APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=15

# Ports below match docker-compose.yml's host-side mappings, which are
# bumped from Postgres/Redis defaults to avoid colliding with any
# locally-installed instance. Only relevant when running the server on
# the host against `make dev-up` infra — the containerized server (`make
# docker-up`) talks to these over the Compose network instead.
DATABASE_URL=postgres://control_plane:control_plane@localhost:55432/control_plane?sslmode=disable
REDIS_URL=redis://localhost:56379/0
NATS_URL=nats://localhost:4222

# stdout | otlp | none
OTEL_EXPORTER=stdout
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

SERVICE_NAME=control-plane-server

# internal/adapters/mcp: the MCP server's Streamable HTTP endpoint for
# tools/call. No default MCP server ships with this repo — point this
# at one you run yourself, or leave the default: tool-call steps will
# just fail with a connection error until you do.
MCP_ENDPOINT=http://localhost:9000/mcp

# internal/adapters/openai: leave OPENAI_BASE_URL empty to hit the real
# OpenAI API (requires a real OPENAI_API_KEY). Model-call steps will
# fail without a valid key — that's expected for local dev without one.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# internal/gateway.RateLimiter: requests per agent (or per source IP
# pre-authentication) per minute.
RATE_LIMIT_PER_MINUTE=120
